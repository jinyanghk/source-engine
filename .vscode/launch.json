{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    {
        "name": "(gdb) Launch",
        "type": "cppdbg",
        "request": "launch",
        //"program": "${workspaceFolder}/hl2/vrad",
        "program": "${workspaceFolder}/hl2/hl2_launcher",
        //"program": "${workspaceFolder}/portal/hl2_launcher",
        //"program": "${workspaceFolder}/cstrike/hl2_launcher",
        //"program": "${workspaceFolder}/cstrike/dedicated_launcher",
        "args": ["-game", "hl2", "-console", "-window", "-height", "768", "-width", "1024", "+map", "d1_town_01_vrad"],
        //"args": ["-game", "portal", "-console", "-window", "-height", "1024", "-width", "768"],
        //"args": ["-game", "cstrike", "-console", "-window", "-height", "1024", "-width", "768"],
        //"args": ["-v", "-game", "hl2", "../../d1_town_01_d.bsp"],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}/hl2",
        //"cwd": "${workspaceFolder}/portal",
        //"cwd": "${workspaceFolder}/cstrike",
        "environment": [
            {
                "name": "LD_LIBRARY_PATH",
                "value": "bin:${env:LD_LIBRARY_PATH}"
            }
        ],
        "externalConsole": false,
        "MIMode": "gdb",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            }
        ]
    }
    ]
}